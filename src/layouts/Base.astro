---
import SEO from '../components/SEO.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/tokens.css'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Markdown pages using `layout:` receive their front matter here, not as props. */
  frontmatter?: { title?: string; description?: string }
}

const { frontmatter } = Astro.props
const title = Astro.props.title ?? frontmatter?.title ?? 'Jian Cui'
const description = Astro.props.description ?? frontmatter?.description ?? ''

// Markdown pages get prose constraints; .astro pages style their own content.
const isMarkdown = Boolean(frontmatter)

// /writing/ is deliberately absent: the page still exists and its URL still
// resolves, it is just unlinked until there is more on it.
const nav = [
  { href: '/', label: 'about' },
  { href: '/#papers', label: 'papers' },
  { href: '/misc/', label: 'misc' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO title={title} description={description} />
    <script is:inline>
      // Both applied before first paint: the theme so the page never flashes the
      // wrong one, and `js` so the reveal styles only apply when they can be
      // undone. Without JavaScript nothing is ever left invisible.
      const saved = localStorage.getItem('theme')
      if (saved) document.documentElement.dataset.theme = saved
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/">Jian Cui</a>
        <nav aria-label="Primary">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="main">
      {
        isMarkdown ? (
          <div class="wrap markdown reveal">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <footer>
      <div class="wrap footer-inner">
        <p>Jian Cui &middot; Urbana&ndash;Champaign</p>
      </div>
    </footer>

    <script is:inline>
      // ~600 bytes, no framework. Reveals each marked block once as it enters
      // the viewport, then stops observing it.
      ;(() => {
        const targets = [...document.querySelectorAll('.reveal')]
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'))
          return
        }

        const show = (el) => {
          el.classList.add('is-visible')
          observer.unobserve(el)
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) if (entry.isIntersecting) show(entry.target)
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        )

        targets.forEach((el) => observer.observe(el))

        // Safety net. IntersectionObserver only reports a *change* in
        // intersection, so a fast jump (an anchor link, the End key, landing on
        // /#papers) can carry an element from below the viewport to above it
        // without it ever intersecting, stranding it invisible forever.
        let queued = false
        const sweep = () => {
          queued = false
          for (const el of targets) {
            if (el.classList.contains('is-visible')) continue
            if (el.getBoundingClientRect().top < window.innerHeight) show(el)
          }
          if (targets.every((el) => el.classList.contains('is-visible'))) {
            window.removeEventListener('scroll', onScroll)
          }
        }
        const onScroll = () => {
          if (queued) return
          queued = true
          requestAnimationFrame(sweep)
        }
        window.addEventListener('scroll', onScroll, { passive: true })
      })()
    </script>

    <style>
      /* Sticky frosted masthead. The translucency needs a real background
         underneath, which is why the hero band stays on --paper. */
      .masthead {
        backdrop-filter: saturate(180%) blur(20px);
        background: color-mix(in srgb, var(--paper) 72%, transparent);
        border-bottom: 1px solid var(--rule);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      @supports not (backdrop-filter: blur(1px)) {
        .masthead {
          background: var(--paper);
        }
      }

      .masthead-inner {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        padding-block: 1rem;
      }

      .wordmark {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: var(--step-1);
        font-variation-settings: 'opsz' 44;
        font-weight: 650;
        letter-spacing: -0.015em;
        margin-right: auto;
        text-decoration: none;
      }

      /* Three items fit inline down to 320px, so there is no hamburger and no
         navigation JavaScript. */
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.35rem;
      }

      nav a {
        color: var(--muted);
        font-size: var(--step--1);
        letter-spacing: 0.01em;
        padding-block: 0.5rem;
        position: relative;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      /* The underline grows from the centre rather than appearing all at once. */
      nav a::after {
        background: var(--accent);
        bottom: 0.25rem;
        content: '';
        height: 1px;
        left: 50%;
        position: absolute;
        transition:
          width 0.25s cubic-bezier(0.22, 1, 0.36, 1),
          left 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        width: 0;
      }

      nav a:hover {
        color: var(--accent);
        opacity: 1;
      }

      nav a:hover::after {
        left: 0;
        width: 100%;
      }

      .skip {
        left: -9999px;
        position: absolute;
      }

      .skip:focus {
        background: var(--raised);
        border-radius: 8px;
        left: 1rem;
        padding: 0.75rem 1rem;
        top: 1rem;
        z-index: 30;
      }

      .markdown {
        padding-block: 4.5rem 0;
      }

      .markdown :global(h1) {
        font-size: var(--step-3);
        margin-bottom: 1.5rem;
      }

      .markdown :global(h2) {
        border-bottom: 1px solid var(--rule);
        font-size: var(--step-1);
        margin-top: 3rem;
        padding-bottom: 0.4rem;
      }

      .markdown :global(p),
      .markdown :global(ul),
      .markdown :global(ol) {
        max-width: var(--measure);
      }

      .markdown :global(ul ul) {
        margin-top: 0.35em;
      }

      footer {
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: var(--step--1);
        margin-top: 6rem;
      }

      .footer-inner {
        padding-block: 2.5rem;
      }

      footer p {
        margin: 0;
      }

      @media (max-width: 400px) {
        nav {
          gap: 0.95rem;
        }
      }
    </style>
  </body>
</html>
