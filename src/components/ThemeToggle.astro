---
import Icon from './Icon.astro'
---

<button id="theme-toggle" type="button" aria-label="Toggle colour theme">
  <span aria-hidden="true" class="icon-light"><Icon name="moon" /></span>
  <span aria-hidden="true" class="icon-dark"><Icon name="sun" /></span>
</button>

<script is:inline>
  ;(() => {
    const KEY = 'theme'
    const root = document.documentElement

    const apply = (value) => {
      root.dataset.theme = value
      localStorage.setItem(KEY, value)
    }

    const current = () =>
      root.dataset.theme ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      apply(current() === 'dark' ? 'light' : 'dark')
    })
  })()
</script>

<style>
  #theme-toggle {
    background: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-size: 1.15rem;
    justify-content: center;
    line-height: 1;
    min-width: 44px;
    padding: 0;
  }

  #theme-toggle:hover {
    color: var(--ink);
  }

  .icon-light,
  .icon-dark {
    align-items: center;
    display: inline-flex;
  }

  .icon-dark {
    display: none;
  }

  :global([data-theme='dark']) .icon-light {
    display: none;
  }

  :global([data-theme='dark']) .icon-dark {
    display: inline-flex;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-light {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .icon-dark {
      display: inline-flex;
    }
  }
</style>
