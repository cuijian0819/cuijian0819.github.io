---
import type { Paper } from '../lib/bibliography.types'
import VenueIcon from './VenueIcon.astro'
import Icon from './Icon.astro'

interface Props {
  paper: Paper
}

const { paper } = Astro.props

// Preprints keep an explicit arXiv label and italic styling.
const isPreprint = paper.venueKey === 'arXiv'
---

<article class="paper">
  <p class="venue-row">
    {/* No whitespace between the glyph and the text: this is an inline context,
        so a newline here would render as a space on top of the icon's margin. */}
    <span class:list={['venue', isPreprint && 'preprint']} title={paper.venueFull}><VenueIcon venueKey={paper.venueKey} />{paper.venue}</span>
  </p>

  <h3>{paper.title}</h3>

  <p class="authors">
    {
      paper.authors.map((author, i) => (
        <>
          {i > 0 && ', '}
          <span class={author.isSelf ? 'self' : undefined}>{author.display}</span>
        </>
      ))
    }
  </p>

  {paper.award && <p class="award"><span class="star">★</span>{paper.award}</p>}

  {
    paper.mediaHtml && (
      <p class="media">
        <span class="media-label"><Icon name="newspaper" /><span>Featured in</span></span>
        {/* Raw anchor tags straight from the bib file's `media` field. */}
        <span class="outlets">
          <Fragment set:html={paper.mediaHtml} />
        </span>
      </p>
    )
  }

  <p class="meta">
    {paper.pdfUrl && <a href={paper.pdfUrl}><Icon name="document" /><span>pdf</span></a>}
    {paper.codeUrl && <a href={paper.codeUrl}><Icon name="code" /><span>code</span></a>}
  </p>
</article>

<style>
  .paper {
    margin: 0 0 3rem;
    max-width: none;
  }

  .venue-row {
    margin: 0 0 0.65rem;
  }

  /* A badge rather than muted inline text. Venue plus year is how a reader
     scans a publication list, so it leads the entry instead of trailing it,
     and it is filled rather than tinted so the column of them reads at a
     glance down the page.
     The fill is the accent darkened toward the ink rather than the accent
     itself: flat --accent against --paper is only 4.0:1, which fails AA for
     text this small. Mixing in 12% ink clears 4.5:1, and because --ink flips
     with the theme the same expression lightens the badge in dark mode. */
  .venue {
    background: color-mix(in srgb, var(--accent) 88%, var(--ink));
    border-radius: 999px;
    color: var(--paper);
    /* inline-block, not inline-flex: the glyph is aligned to the text baseline
       inside VenueIcon, which flex centring overrides. */
    display: inline-block;
    font-size: var(--step--1);
    font-variant-caps: all-small-caps;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.4rem 0.8rem;
    white-space: nowrap;
  }

  /* Peer review is the distinction worth drawing, so a preprint keeps the badge
     shape but loses the fill: outlined reads as "not a venue" without needing a
     second label. The border is subtracted from the padding so the pill stays
     the same size as a filled one and the column of them still lines up. */
  .venue.preprint {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    color: color-mix(in srgb, var(--accent) 88%, var(--ink));
    padding: calc(0.4rem - 1px) calc(0.8rem - 1px);
  }

  .paper h3 {
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 28;
    margin-bottom: 0.45rem;
    /* Overrides the global heading `balance`. Balancing equalises line lengths,
       which suits a two-word section heading but wrecks a long paper title: it
       leaves the first line half empty and breaks mid-phrase, e.g.
       "... Measuring Convention / Implications of Web Bots ...".
       `pretty` fills each line and only protects against a short last line. */
    text-wrap: pretty;
  }

  .authors {
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0 0 0.5rem;
  }

  /* Marker-pen highlight. Finding your own name in an eight-author list should
     not require reading it, and a bolder weight alone was not enough. */
  .authors .self {
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--accent) 24%, transparent) 0.32em,
      transparent 0.32em
    );
    color: var(--ink);
    font-weight: 650;
    padding: 0 0.1em;
  }

  .award {
    align-items: baseline;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-radius: 8px;
    /* 75%, matching .media-label: on the tinted pill rather than on --paper the
       88% mix measures 4.18:1, under AA. This clears it at 4.83:1. */
    color: color-mix(in srgb, var(--accent) 75%, var(--ink));
    display: inline-flex;
    font-size: var(--step--1);
    gap: 0.45rem;
    margin: 0 0 0.55rem;
    padding: 0.35rem 0.7rem;
  }

  .star {
    color: var(--accent);
    flex: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    margin: 0;
  }

  /* Small outlined buttons rather than bare inline links, so the row reads as
     actions and lines up with the venue badge's shape. */
  .meta a {
    align-items: center;
    display: inline-flex;
    gap: 0.3em;
    border: 1px solid var(--rule);
    border-radius: 6px;
    color: var(--muted);
    line-height: 1;
    padding: 0.32rem 0.6rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .meta a:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    opacity: 1;
  }

  /* Press coverage is the one line on this page a reader outside security
     recognises, so it gets the award's tinted-pill treatment instead of a grey
     footnote, and the mastheads are set in ink rather than muted. It also sits
     above the pdf/code row now: those are utilities, this is evidence. */
  .media {
    align-items: baseline;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-radius: 8px;
    display: inline-flex;
    flex-wrap: wrap;
    /* Body size, a step above the award and the author line. Twice now the row
       has read as a footnote at --step--1; the mastheads are the point. */
    font-size: var(--step-0);
    gap: 0.15rem 0.55rem;
    margin: 0 0 0.6rem;
    padding: 0.45rem 0.8rem;
  }

  .media-label {
    align-items: baseline;
    display: inline-flex;
    gap: 0.4em;
    /* 75% not 88%: this label sits on the tinted pill rather than on --paper,
       where the 88% mix measures 4.18:1, under AA for text this size. 75%
       gives 4.83:1 in light and 7.34:1 in dark. */
    color: color-mix(in srgb, var(--accent) 75%, var(--ink));
    flex: none;
    /* Matches the outlets rather than sitting a step under them: small-caps
       already renders about a third shorter than its nominal size, which is
       what kept making this label disappear. */
    font-size: var(--step-0);
    font-variant-caps: all-small-caps;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .outlets :global(a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .outlets :global(a:hover) {
    color: var(--accent);
    opacity: 1;
    text-decoration-color: var(--accent);
  }
</style>
