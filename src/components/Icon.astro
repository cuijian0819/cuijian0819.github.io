---
interface Props {
  name: 'document' | 'code' | 'newspaper' | 'arrow-left'
}

const paths = {
  document: ['M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z', 'M14 3v6h6', 'M8 13h8M8 17h5'],
  code: ['m8 7-5 5 5 5', 'm16 7 5 5-5 5', 'm14 4-4 16'],
  newspaper: ['M4 4h16v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z', 'M8 8h8M8 12h3v5H8Z', 'M14 12h2M14 16h2'],
  'arrow-left': ['M20 12H4', 'm10 6-6 6 6 6'],
}
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {paths[Astro.props.name].map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    display: inline-block;
    fill: none;
    flex: none;
    height: 1em;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    vertical-align: -0.12em;
    width: 1em;
  }
</style>
