---
// Inline SVG rather than an icon font: keeps the "no third-party request"
// constraint and avoids shipping a whole icon set for four glyphs.
export interface Chip {
  href: string
  label: string
  icon: 'cv' | 'scholar' | 'linkedin' | 'x'
}

interface Props {
  chips: Chip[]
}

const { chips } = Astro.props
---

<p class="chips">
  {
    chips.map((chip) => (
      <a class="chip" href={chip.href}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {chip.icon === 'cv' && (
            <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2.5H6.75A1.75 1.75 0 0 0 5 4.25v15.5c0 .97.78 1.75 1.75 1.75h10.5A1.75 1.75 0 0 0 19 19.75V7.5z" />
              <path d="M14 2.5V7.5H19" />
              <path d="M8.5 12.5h7M8.5 16h4.5" />
            </g>
          )}
          {chip.icon === 'scholar' && (
            <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3.5 22 9l-10 5.5L2 9z" />
              <path d="M6.5 11.4v4.4c0 1.6 2.46 2.95 5.5 2.95s5.5-1.35 5.5-2.95v-4.4" />
              <path d="M21 9.6v4.9" />
            </g>
          )}
          {chip.icon === 'linkedin' && (
            <path
              fill="currentColor"
              d="M6.94 8.6v11.9H3.2V8.6zM5.07 3.5a2.17 2.17 0 1 1 0 4.34 2.17 2.17 0 0 1 0-4.34m4.24 5.1h3.58v1.63h.05c.5-.94 1.72-1.93 3.53-1.93 3.78 0 4.48 2.48 4.48 5.71v6.49h-3.73v-5.75c0-1.37-.03-3.14-1.92-3.14-1.92 0-2.21 1.5-2.21 3.04v5.85H9.31z"
            />
          )}
          {chip.icon === 'x' && (
            <path
              fill="currentColor"
              d="M17.53 3h2.9l-6.33 7.24L21.5 21h-5.66l-4.44-5.8L6.32 21H3.4l6.77-7.74L2.8 3h5.8l4.02 5.31zm-1.02 16.2h1.6L7.6 4.7H5.88z"
            />
          )}
        </svg>
        <span>{chip.label}</span>
      </a>
    ))
  }
</p>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
  }

  .chip {
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    display: inline-flex;
    font-size: var(--step--1);
    gap: 0.45rem;
    line-height: 1;
    min-height: 44px;
    padding: 0 0.95rem;
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .chip svg {
    height: 1.05em;
    width: 1.05em;
    flex: none;
  }

  .chip:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent);
    opacity: 1;
  }

  @media (max-width: 400px) {
    .chip {
      padding: 0 0.75rem;
    }
  }
</style>
