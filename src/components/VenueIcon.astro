---
import Icon from './Icon.astro'

// Field symbols share the same outline family as paper actions and awards.
interface Props {
  venueKey: string
}

const { venueKey } = Astro.props

type Field = 'security' | 'ai'

const FIELD: Record<string, Field> = {
  NDSS: 'security',
  CCS: 'security',
  Security: 'security',
  ACL: 'ai',
  NAACL: 'ai',
  CIKM: 'ai',
}

const field = FIELD[venueKey]
---

{field && <span class="venue-icon"><Icon name={field === 'security' ? 'shield' : 'sparkles'} /></span>}

<style>
  .venue-icon {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
    margin-right: 0.35em;
  }
</style>
