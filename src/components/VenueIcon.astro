---
import Icon from './Icon.astro'

// Field symbols share the same outline family as paper actions and awards.
interface Props {
  venueKey: string
}

const { venueKey } = Astro.props

const VENUE_ICON: Record<string, 'shield' | 'book' | 'database'> = {
  NDSS: 'shield',
  CCS: 'shield',
  Security: 'shield',
  ACL: 'book',
  NAACL: 'book',
  CIKM: 'database',
}

const icon = VENUE_ICON[venueKey]
---

{icon && <span class="venue-icon"><Icon name={icon} /></span>}

<style>
  .venue-icon {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
    margin-right: 0.35em;
  }
</style>
