---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Thoughts from '../../layouts/Thoughts.astro'
import Icon from '../../components/Icon.astro'

export async function getStaticPaths() {
  return (await getCollection('thoughts')).map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'thoughts'>
}

const { post } = Astro.props
const { Content } = await render(post)
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.date)
---

<Thoughts
  title={`${post.data.title} · Jian Cui`}
  description={post.data.summary ?? post.data.title}
>
  <div class="thought wrap">
    <article class="essay">
      <a class="back" href="/thoughts/"><Icon name="arrow-left" /><span>All thoughts</span></a>
      <header class="essay-head">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
        <h1>{post.data.title}</h1>
        {post.data.summary && <p class="summary">{post.data.summary}</p>}
      </header>
      <div class="body">
        <Content />
      </div>
      <a class="back bottom" href="/thoughts/"><Icon name="arrow-left" /><span>All thoughts</span></a>
    </article>
  </div>
</Thoughts>

<style>
  .thought {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .essay {
    margin-left: calc(var(--gutter-col) + 2rem);
    max-width: var(--column);
  }

  .back {
    align-items: center;
    color: var(--muted);
    display: inline-flex;
    gap: 0.4em;
    font-size: 0.95em;
    margin-bottom: 2rem;
  }

  .essay-head {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.5rem;
  }

  time {
    color: var(--muted);
    display: block;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4375rem, 2rem + 1.1vw, 2.875rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-bottom: 0;
    text-wrap: pretty;
  }

  .summary {
    color: var(--muted);
    font-style: italic;
    margin: 1rem 0 0;
  }

  .body {
    margin-top: 2rem;
  }

  .body :global(p) {
    margin-bottom: 1.15em;
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .body :global(h2) {
    font-size: 1.35em;
    font-weight: 400;
    line-height: 1.2;
    margin: 2em 0 0.7em;
    text-wrap: pretty;
  }

  .body :global(h3) {
    font-size: 1.1em;
    font-weight: 400;
    font-style: italic;
    margin: 2em 0 0.6em;
  }

  .body :global(blockquote) {
    border-left: 1px solid var(--rule);
    color: var(--muted);
    font-style: italic;
    margin: 1.6em 0;
    padding-left: 1.4rem;
  }

  .body :global(.flow-figure) {
    border-block: 3px double var(--ink);
    margin: 2rem 0;
    padding-block: 0.25rem 1rem;
  }

  .body :global(.flow-case) {
    border-bottom: 1px solid var(--rule);
    padding-block: 1rem;
  }

  .body :global(.flow-case h3) {
    font-size: 1em;
    font-style: normal;
    font-weight: 500;
    margin: 0 0 0.6rem;
  }

  .body :global(.flow-case p) {
    font-size: 0.95em;
    margin: 0;
  }

  .body :global(.flow-case .flow-path) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.5em;
    font-style: italic;
    margin-bottom: 0.6rem;
  }

  .body :global(.flow-figure figcaption) {
    color: var(--muted);
    font-size: 0.9em;
    line-height: 1.4;
    padding-top: 1rem;
  }

  .bottom {
    margin: 2.5rem 0 0;
  }

  @media (max-width: 639px) {
    .essay {
      margin-left: 0;
    }
  }
</style>
