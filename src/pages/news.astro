---
import Base from '../layouts/Base.astro'
import NewsList from '../components/NewsList.astro'
---

<Base title="News · Jian Cui" description="Announcements and updates from Jian Cui.">
  <section class="page wrap reveal">
    <h1>News</h1>
    <NewsList />
  </section>
</Base>

<style>
  .page {
    padding-block: 4rem 0;
  }

  .page h1 {
    font-size: var(--step-3);
    margin-bottom: 2rem;
  }
</style>
