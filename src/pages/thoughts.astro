---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'

// Deliberately unlinked from the navigation, like /writing/ was. The page and
// its URL are live; only someone with the link finds it.
const posts = (await getCollection('thoughts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const rendered = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content })),
)

// Bare YYYY-MM-DD parses as UTC midnight; formatting in local time would shift
// it a day west of GMT.
const formatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<Base
  title="Thoughts · Jian Cui"
  description="Notes from Jian Cui on agentic AI security, prompt injection, and where the defences actually belong."
>
  <section class="page wrap">
    <header class="page-head reveal">
      <h1>Thoughts</h1>
      <p class="standfirst">
        Working notes on agentic AI security. Half-formed on purpose; I would rather write these down
        than wait until they are papers.
      </p>
    </header>

    {
      rendered.map(({ post, Content }) => (
        <article class="entry reveal">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatter.format(post.data.date)}
          </time>
          <h2>{post.data.title}</h2>
          <div class="body">
            <Content />
          </div>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .page {
    padding-block: 4rem 0;
  }

  .page-head {
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
    padding-bottom: 2rem;
  }

  .page h1 {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .standfirst {
    color: var(--muted);
    margin: 0;
    max-width: var(--measure);
  }

  .entry {
    margin-bottom: 4rem;
    max-width: var(--measure);
  }

  .entry time {
    color: var(--muted);
    display: block;
    font-size: 0.72rem;
    font-variant-caps: all-small-caps;
    font-weight: 650;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }

  .entry h2 {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
    text-wrap: pretty;
  }

  .entry .body :global(p) {
    margin-bottom: 1.35em;
  }

  .entry .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
