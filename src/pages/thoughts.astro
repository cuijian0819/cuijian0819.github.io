---
import { getCollection } from 'astro:content'
import Thoughts from '../layouts/Thoughts.astro'

// Deliberately unlinked from the navigation, like /writing/ was. The page and
// its URL are live; only someone with the link finds it.
const posts = (await getCollection('thoughts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

// Bare YYYY-MM-DD parses as UTC midnight; formatting in local time would shift
// it a day west of GMT.
const utc = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-GB', { ...options, timeZone: 'UTC' })
const dayMonth = utc({ day: 'numeric', month: 'short' })
const yearOnly = utc({ year: 'numeric' })

// The year is printed in the left margin once per year, not once per entry.
let lastYear = ''
const entries = posts.map((post) => {
  const year = yearOnly.format(post.data.date)
  const showYear = year !== lastYear
  lastYear = year
  return { post, year, showYear }
})
---

<Thoughts
  title="Thoughts · Jian Cui"
  description="Notes from Jian Cui on computer security, research, and education."
>
  <div class="thoughts wrap">
    <header class="head reveal">
      <h1>Thoughts</h1>
      <p class="standfirst">Whatever crosses my mind late at night.</p>
    </header>

    {
      entries.map(({ post, year, showYear }) => (
        <article class="entry reveal">
          <div class="gutter">{showYear && <span class="year">{year}</span>}</div>
          <div class="column">
            <div class="entry-head">
              <h2><a href={`/thoughts/${post.id}/`}>{post.data.title}</a></h2>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {dayMonth.format(post.data.date)}
              </time>
            </div>
            {post.data.summary && <p class="summary">{post.data.summary}</p>}
          </div>
        </article>
      ))
    }
  </div>
</Thoughts>

<style>
  .thoughts {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .head {
    margin: 0 0 clamp(2.5rem, 5vw, 4rem) auto;
    margin-left: calc(var(--gutter-col) + 2rem);
    max-width: var(--column);
  }

  .head h1 {
    font-size: clamp(2.4375rem, 2rem + 1.1vw, 2.875rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin-bottom: 0.6rem;
  }

  .standfirst {
    color: var(--muted);
    font-size: 1.05em;
    font-style: italic;
    margin: 0;
  }

  /* Year in the margin, essay in the column. */
  .entry {
    display: grid;
    gap: 2rem;
    grid-template-columns: var(--gutter-col) minmax(0, var(--column));
    margin-bottom: 2rem;
  }

  .year {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    line-height: 2.6;
  }

  .column {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.5rem;
  }

  /* Titles stay beside their dates, with a takeaway underneath. */
  .entry-head {
    align-items: baseline;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
  }

  .entry-head h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.2;
    margin: 0;
    text-wrap: pretty;
  }

  .entry-head a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-head a:hover,
  .entry-head a:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }

  .entry-head time {
    color: var(--muted);
    flex: none;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .summary {
    color: var(--muted);
    font-style: italic;
    margin: 0.5rem 0 0;
  }

  /* The margin is the first thing to go on a phone: the year moves inline,
     above the title it belongs to. */
  @media (max-width: 639px) {
    .head {
      margin-left: 0;
    }

    .entry {
      gap: 0.4rem;
      grid-template-columns: 1fr;
    }

    .year {
      line-height: 1;
    }
  }
</style>
